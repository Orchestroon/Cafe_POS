# Copy to `.env` on the server (`cp .env.prod.example .env`) and fill it in. NEVER commit `.env`.
# Used by docker-compose.prod.yml. Every value is a plain KEY=value (no quotes, no spaces).

# --- Required ---------------------------------------------------------------------------------
# The host name of the POS, e.g. pos.mycafe.com. Its DNS record must already point to this server
# (ports 80 and 443 open) so Caddy can get the HTTPS certificate. "localhost" = local test.
DOMAIN=
# Django secret key. Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Database password (any long random text, letters and digits are safest).
POSTGRES_PASSWORD=

# --- Optional ---------------------------------------------------------------------------------
# Gunicorn workers: about 2 x CPU cores + 1. The default 3 suits a small server.
GUNICORN_WORKERS=3
# HTTPS memory ("HSTS"): starts at 1 day so a mistake is easy to undo. Once HTTPS works for sure,
# raise it to 31536000 (1 year) and recreate the stack.
HSTS_SECONDS=86400
# Add HSTS to every subdomain of DOMAIN too (only if all of them use HTTPS).
HSTS_INCLUDE_SUBDOMAINS=false

# Backups: every day at BACKUP_TIME (café time, TZ), kept BACKUP_KEEP_DAYS days in BACKUP_DIR.
# Copy that folder off the server too: a backup on the same disk is lost with the server.
TZ=Africa/Cairo
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=14
BACKUP_DIR=./backups
# The backup files belong to this user/group on the server (run `id` to see yours).
BACKUP_UID=1000
BACKUP_GID=1000

# Ports on the server (only change for a local test next to something else).
HTTP_PORT=80
HTTPS_PORT=443

# --- Behind a Cloudflare Tunnel (the tunnel provides HTTPS) -----------------------------------
# Uncomment all three; point the tunnel at http://web:80. See docs/OPERATIONS.md.
# CADDY_SITE_ADDRESS=:80
# CADDY_AUTO_HTTPS=off
# CADDY_TRUSTED_PROXIES=private_ranges
